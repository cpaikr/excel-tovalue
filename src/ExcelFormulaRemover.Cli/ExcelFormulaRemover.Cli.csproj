<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>excel-formula-remover</AssemblyName>
    <Description>Automatable command-line interface for Excel formula removal.</Description>
    <!-- The engine uses only ordinal and invariant operations, so the standalone
         executable does not need ICU, which minimal Linux hosts often lack. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ExcelFormulaRemover.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExcelFormulaRemover.Core\ExcelFormulaRemover.Core.csproj" />
  </ItemGroup>
</Project>
